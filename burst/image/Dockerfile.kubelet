# Runtime burst-node image. All heavy downloads live in the base
# (Dockerfile.kubelet.base) so this build is just an entrypoint
# overlay — push takes ~5s.
ARG BASE_IMAGE=registry.fly.io/yscale-burst-base:latest
FROM ${BASE_IMAGE}

# Build from the source root, like the service images.
COPY burst/image/entrypoint-kubelet.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
