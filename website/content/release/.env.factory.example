# Operator-owned mesh factory. Keep separate from .env.cloud: DATABASE_URL
# and LINODE_TOKEN belong to the factory's isolated trust boundary.
# See docs/self-hosted-mesh.md and deploy/runbooks/factory.md#environment-variables.
FACTORY_LISTEN=:8080
# Bind to a PRIVATE ops-mesh interface in production, never a public address.
FACTORY_OPS_LISTEN=127.0.0.1:8081
# Base URL reachable FROM boxes; bootstrap appends /ops/register.
# Loopback requires an explicitly configured private ops proxy to be reachable.
FACTORY_OPS_URL=http://factory-ops.example.invalid:8081
FACTORY_BEARER_TOKEN=
# Base64-encoded 32-byte key; back it up separately from encrypted DB backups.
FACTORY_KEK=
DATABASE_URL=
# Current production factory creates Linode coordination boxes, even when
# burst workers use another provider. These are billable resources.
LINODE_TOKEN=
# HTTPS origin of your separate, self-hosted ops Headscale coordinator.
# Required: an empty value never falls back to Tailscale's hosted service.
FACTORY_OPS_LOGIN_SERVER=https://ops-headscale.example.invalid
# Headscale pre-auth key for coordination BOXES; no Tailscale account needed.
# This does not join the factory pod; configure its private ops client separately.
FACTORY_OPS_AUTHKEY=
# FACTORY_DEV=1 is ONLY an in-memory fake worker for no-cloud tests, not a
# usable mesh. Leave unset for real deployments.
