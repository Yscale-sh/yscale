# yscale-agent — env vars for the customer-cluster agent
#
# In production: NOT used as a .env file — these values come from
# Helm values + a Secret in the customer's cluster. See
# deploy/helm/yscale-agent/values.yaml.
#
# This file documents the surface for local development
# (`go run ./agent/cmd/yscale-agent`) and for ops debugging.
#
# Copy to .env.agent, fill in, source before running:
#   set -a; source .env.agent; set +a
#   go run ./agent/cmd/yscale-agent

# ─── Customer auth ───────────────────────────────────────────────────
# Per-customer bearer token central uses to identify which install
# this agent belongs to. Issued out-of-band when the customer
# provisions a tenant on your own central. No built-in token is valid.
# Obtain this from your operator's provisioning response and keep it secret.
YSCALE_TOKEN=

# ─── Central endpoint ────────────────────────────────────────────────
# WebSocket URL the agent dials. Production: your own central's TLS endpoint.
# Local dev: ws://yscale-cloud.yscale:8443 (cluster-internal Service)
YSCALE_ENDPOINT=ws://yscale-cloud.yscale:8443

# ─── Cluster identity ────────────────────────────────────────────────
# Stable per-cluster UUID. If unset, agent reads/creates one in
# --state-dir (default /var/lib/yscale/cluster-id). Set explicitly
# only when migrating an agent install across clusters intentionally.
YSCALE_CLUSTER_ID=

# ─── Gateway tier feature flag ───────────────────────────────────────
# When true, agent permits default/full networking-tier submissions.
# Set false only for installs that intentionally omit the gateway sidecar;
# those installs reject default/full workloads at submit with a clear error.
# Helm sets this from .Values.gateway.enabled.
# Accepted true values: 1, true, yes, on (case-insensitive). Any other
# non-empty value is treated as false.
YSCALE_GATEWAY_ENABLED=true

# ─── In-cluster service-account derived (only when running in K8s) ──
# These are auto-injected by the kubelet when the agent runs as a Pod
# with a ServiceAccount. NOT needed for local dev unless you're
# pointing at a kubeconfig with `KUBECONFIG=...` instead.
# KUBERNETES_SERVICE_HOST=kubernetes.default.svc
# KUBERNETES_SERVICE_PORT=443

# ─── Bootstrap endpoint override (advanced) ──────────────────────────
# Override the apiserver URL the agent stamps into burst bootstrap-
# kubeconfigs. Point at a tailscale-hosted proxy when the cluster's
# real apiserver isn't reachable over tailnet directly. Almost never
# set in production.
# BOOTSTRAP_APISERVER_URL=https://k3s.tail-scale.ts.net:6443
