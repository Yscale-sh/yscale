# yscale-cloud — self-hosted central with operator-managed mesh/factory.
# See docs/self-hosted-mesh.md. This is not a Yscale-operated service.
#
# Copy to .env.cloud, fill in real values, source before running:
#   set -a; source .env.cloud; set +a
#   go run ./central/cmd/yscale-cloud
#
# Or render as a K8s Secret with `kubectl create secret generic ...`
# and reference from the cloud Deployment (deploy/cloud/cloud.yaml).
#
# NEVER commit a filled-in .env.cloud. Only .env.*.example files are tracked.

# ─── Managed mesh (default for every full-source build) ─────────────
# Operator-owned central URL, reachable by your cluster connectors. Terminate
# TLS at your ingress/reverse proxy; central's -listen serves plain HTTP.
YSCALE_CENTRAL_ENDPOINT=https://central.example.invalid
# Factory is private, reachable by central only. Use your own service address.
FACTORY_URL=http://yscale-factory.yscale-factory:8080
# Generate a dedicated random token; identical value on central and factory.
FACTORY_BEARER_TOKEN=
# Operator/admin API token, separate from the factory bearer and tenant tokens.
YSCALE_ADMIN_TOKEN=
# Durable central state. Never reuse the factory's database/credentials.
DATABASE_URL=
# Base64-encoded 32-byte key protecting stored provider credentials; back up.
YSCALE_CREDENTIAL_MASTER_KEY=
# Optional durable lifecycle database: migrate with yscale-lifecycle-migrate
# before configuring it. See docs/self-hosted-mesh.md for safety requirements.
LIFECYCLE_DATABASE_URL=
# Do not set TS_OAUTH_CLIENT_ID / TS_OAUTH_CLIENT_SECRET. Shared Tailscale
# coordination is not the full release's fallback. The factory supplies each
# tenant's Headscale/DERP endpoint. Tailscale clients still run on nodes.
YSCALE_BURST_MAX_LIFETIME=90m

# Burst-node image. The compiled-in default is private to the original
# maintainer's Fly org and will not pull for you: build your own from
# burst/image and set its immutable reference here.
YSCALE_BURST_IMAGE=

# ─── Fly.io backend ──────────────────────────────────────────────────
# Leave empty unless you enable this backend. Personal access token from
# https://fly.io/dashboard → Tokens. Org + region default to "personal"/"ord".
FLYIO_TOKEN=
FLY_ORG=personal
FLY_REGION=ord

# ─── Linode backend ──────────────────────────────────────────────────
# Leave empty unless you enable this backend. This is central's BURST token,
# not the factory's box-scoped token. Personal access token from
# cloud.linode.com → API Tokens.
# Scopes needed: linodes:read_write, images:read_only, regions:read_only.
# Optional SSH public key for emergency lish console access on baked images.
LINODE_TOKEN=
LINODE_REGION=us-ord
LINODE_SSH_KEY=

# ─── Placement preview launch tokens ─────────────────────────────────
# HMAC-SHA256 key central signs the placement-preview launch token with.
# A preview returns `launch_token`; the launch presents it back in the
# X-Yscale-Placement-Token header, and central verifies that the decision
# digest and the expiry it names are ones IT issued, to THIS account.
#
# Generate 32+ random bytes and keep it stable:
#   openssl rand -base64 48
#
# It is its OWN secret. Do not reuse YSCALE_ADMIN_TOKEN or a provider
# credential: anyone holding those would be able to mint launch tokens,
# and rotating either would silently retire the other's purpose.
#
# Stable and shared across replicas, deliberately — a preview answered by
# one replica is launched against another, and a restart must not
# invalidate the previews customers are holding. Rotating it is safe and
# retires every outstanding preview: clients preview again.
#
# Unset = launch binding OFF. Central logs a warning at boot, previews
# still answer the decision but hand out no token, and a launch that
# presents one is REFUSED (503) rather than honored unverified. Central
# refuses to start if this is set but under 32 bytes.
YSCALE_PLACEMENT_TOKEN_KEY=
